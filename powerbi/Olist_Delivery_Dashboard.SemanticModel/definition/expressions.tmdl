/// Delivered orders with a non-null customer delivery date (shared by orders and order_items).
expression q_orders_delivered =
		let
		    Source = Excel.Workbook(File.Contents("C:\Users\isc\OneDrive\Attachments\olist_orders_dataset.xlsx"), null, true),
		    Sheet = Source{[Item="olist_orders_dataset",Kind="Sheet"]}[Data],
		    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
		    Typed = Table.TransformColumnTypes(Promoted,{{"order_id", type text}, {"customer_id", type text}, {"order_status", type text}, {"order_purchase_timestamp", type datetime}, {"order_approved_at", type datetime}, {"order_delivered_carrier_date", type datetime}, {"order_delivered_customer_date", type datetime}, {"order_estimated_delivery_date", type datetime}}),
		    Delivered = Table.SelectRows(Typed, each [order_status] = "delivered" and [order_delivered_customer_date] <> null),
		    AddDate = Table.AddColumn(Delivered, "purchase_date", each Date.From([order_purchase_timestamp]), type date),
		    Keep = Table.SelectColumns(AddDate, {"order_id", "customer_id", "order_status", "order_purchase_timestamp", "order_delivered_carrier_date", "order_delivered_customer_date", "order_estimated_delivery_date", "purchase_date"})
		in
		    Keep
	lineageTag: e6088ebb-3316-4ccd-ae3e-4803acb08144


{
  "name": "Olist Delivery",
  "dataColors": [
    "#64748B",
    "#EA580C",
    "#0F766E",
    "#334155",
    "#94A3B8",
    "#FDBA74",
    "#5EEAD4",
    "#1E293B"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#0F766E",
  "good": "#0F766E",
  "bad": "#EA580C",
  "neutral": "#64748B",
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#0F172A"
    },
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 22,
      "color": "#0F172A"
    },
    "title": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#0F172A"
    },
    "header": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#64748B"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "border": [
          {
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 8
          }
        ]
      }
    }
  }
}